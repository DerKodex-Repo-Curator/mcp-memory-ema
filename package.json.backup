    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "example": "ts-node src/example.ts",
    "cli": "ts-node src/cli.ts"
  },
  "keywords": [
    "mcp-tool",
    "memory",
    "ai",
    "consciousness"
  ],
  "author": "",
