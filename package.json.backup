  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "ts-jest": "^29.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "@types/uuid": "^9.0.7",
    "eslint": "^8.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "prettier": "^3.0.0"
  }
}